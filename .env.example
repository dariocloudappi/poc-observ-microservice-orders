# ============================================================
# AZURE SQL DATABASE / SQL SERVER
# ============================================================
# JDBC URL de la base de datos
# Azure SQL: jdbc:sqlserver://<servidor>.database.windows.net:1433;database=<db>;encrypt=true;trustServerCertificate=false;loginTimeout=30
# SQL Server local: jdbc:sqlserver://localhost:1433;database=ordersdb;encrypt=false;trustServerCertificate=true
SQL_URL=jdbc:sqlserver://tu-servidor.database.windows.net
SQL_SERVER_PORT=1433
SQL_USERNAME=tu_usuario
SQL_PASSWORD=tu_contraseña

# ============================================================
# SERVICIO DE USUARIOS (microservicio externo)
# ============================================================
USERS_SERVICE_URL=http://localhost:8081
USERS_SERVICE_USERNAME=admin
USERS_SERVICE_PASSWORD=password

# ============================================================
# SEGURIDAD DE LA API (Basic Auth)
# ============================================================
API_USERNAME=admin
API_PASSWORD=password

# ============================================================
# OPENTELEMETRY - CONFIGURACIÓN ZERO-CODE
# Estas variables las lee el agente OTEL en tiempo de ejecución.
# NO se necesita código adicional en la aplicación.
# ============================================================

# Nombre del servicio que aparecerá en New Relic
OTEL_SERVICE_NAME=microservice-orders

# Endpoint OTLP de New Relic (HTTPS, puerto 4318)
OTEL_EXPORTER_OTLP_ENDPOINT=https://otlp.nr-data.net:4318

# Tu License Key de New Relic (Ingest - License, no User API Key)
OTEL_EXPORTER_OTLP_HEADERS=api-key=tu_new_relic_license_key_aqui

# Protocolo OTLP: http/protobuf es el recomendado para HTTPS
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf

# Habilitar exportación de trazas, métricas y logs
OTEL_TRACES_EXPORTER=otlp
OTEL_METRICS_EXPORTER=otlp
OTEL_LOGS_EXPORTER=otlp

# Atributos del recurso (aparecen como tags en New Relic)
OTEL_RESOURCE_ATTRIBUTES=service.name=microservice-orders,deployment.environment=local,service.version=1.0.0

# Intervalo de exportación de métricas en milisegundos (30 segundos)
OTEL_METRIC_EXPORT_INTERVAL=30000

# Muestreo de trazas: parentbased_always_on = 100% (reducir en producción si hay alto volumen)
OTEL_TRACES_SAMPLER=parentbased_always_on

# ============================================================
# OPENTELEMETRY - LOGBACK APPENDER (zero-code, vía agente)
# El agente OTel instrumenta Logback automáticamente y exporta
# los logs con severityText (= level) como campo estándar OTel.
# New Relic mapea severityText -> atributo "level" en Logs UI.
#
# Las dos variables siguientes habilitan la captura adicional de:
#   - key-value pairs del API fluida SLF4J 2.x  (log.atInfo().addKeyValue(...))
#   - atributos MDC (http.method, http.target, etc.)
# Sin ellas, esos campos no llegan a New Relic aunque el level sí.
# ============================================================
OTEL_INSTRUMENTATION_LOGBACK_APPENDER_EXPERIMENTAL_CAPTURE_KEY_VALUE_PAIR_ATTRIBUTES=true
OTEL_INSTRUMENTATION_LOGBACK_APPENDER_EXPERIMENTAL_CAPTURE_MDC_ATTRIBUTES=*

# ============================================================
# JAVA AGENT (para ejecución local)
# ============================================================
# Descomentar y ajustar la ruta al agente OTEL descargado con mvn package
# JAVA_TOOL_OPTIONS=-javaagent:./targetv6/otel-javaagent.jar

# ============================================================
# APLICACIÓN
# ============================================================
PORT=8080
ENVIRONMENT=local
