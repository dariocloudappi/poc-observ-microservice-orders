# =============================================================================
# .env.example - microservice-orders
# -----------------------------------------------------------------------------
# Copy to .env and replace every CHANGE_ME. .env is git ignored and must never
# be committed. None of the values below works as it is.
#
# This file is only for running the service locally. In Azure the same values
# are applied as App Service settings by infra/main.bicep, fed from GitHub
# Secrets.
# =============================================================================

# =============================================================================
# Server
# =============================================================================

PORT=8080

# TRACE | DEBUG | INFO | WARN | ERROR
LOG_LEVEL=INFO

# Level of the org.hibernate.SQL logger. DEBUG sends every executed statement
# to New Relic as a log record correlated with its trace. Raises log volume.
SQL_LOG_LEVEL=INFO

# Level of the org.hibernate.orm.jdbc.bind logger. TRACE also logs the bind
# parameter values, which is the data sent to the database. Debugging only.
SQL_BIND_LOG_LEVEL=INFO

# deployment.environment attribute reported to New Relic
ENVIRONMENT=local

# =============================================================================
# Azure SQL Database
# -----------------------------------------------------------------------------
# application.yml builds the JDBC url from these five variables:
#   jdbc:sqlserver://${SQL_SERVER}:${SQL_SERVER_PORT};database=${SQL_DATABASE};
#   user=[${SQL_USERNAME}]@${SQL_SERVER_NAME};password=${SQL_PASSWORD};...
# SQL_SERVER is the full FQDN and SQL_SERVER_NAME the short name: the login
# format is "user@server" and needs both.
#
# The schema is NOT created by Hibernate (ddl-auto: none). Apply
# src/main/resources/database.sql before starting the service.
# =============================================================================

SQL_SERVER=CHANGE_ME_SERVER.database.windows.net
SQL_SERVER_NAME=CHANGE_ME_SERVER
SQL_SERVER_PORT=1433
SQL_DATABASE=sqldb-orders
SQL_USERNAME=CHANGE_ME_SQL_ADMIN_USER
SQL_PASSWORD=CHANGE_ME_SQL_ADMIN_PASSWORD

# =============================================================================
# Basic Auth accepted by this API
# -----------------------------------------------------------------------------
# These are the credentials the Tyk gateway presents to this service. They must
# match UPSTREAM_ORDERS_BASIC_USER and UPSTREAM_ORDERS_BASIC_PASSWORD in the
# gateway repository.
# =============================================================================

BASIC_AUTH_USER=CHANGE_ME_BASIC_AUTH_USER
BASIC_AUTH_PASSWORD=CHANGE_ME_BASIC_AUTH_PASSWORD

# =============================================================================
# Tyk gateway (downstream dependency)
# -----------------------------------------------------------------------------
# Orders validates the owner of an order against microservice-users, pero NO
# directamente: la llamada va al gateway de Tyk, que la enruta.
#
# Por eso las credenciales son las de CONSUMIDOR del gateway
# (USERNAME_API_USERS / PASSWORD_API_USERS en el repositorio del gateway) y no
# el BASIC_AUTH_* de microservice-users: Tyk sustituye la cabecera Authorization
# antes de reenviar al upstream.
#
# Sin barra final en la url.
# =============================================================================

GATEWAY_BASE_URL=https://localhost:8443
GATEWAY_USERS_PATH=/api-users/v1
GATEWAY_BASIC_USER=CHANGE_ME_GATEWAY_CONSUMER_USER
GATEWAY_BASIC_PASSWORD=CHANGE_ME_GATEWAY_CONSUMER_PASSWORD

# =============================================================================
# OpenTelemetry, zero-code instrumentation
# -----------------------------------------------------------------------------
# The Java agent reads these variables at run time. No code change is needed.
# The values below are the ones New Relic documents for its OTLP endpoint.
# =============================================================================

OTEL_SERVICE_NAME=microservice-orders

# EU accounts: https://otlp.eu01.nr-data.net:4318   US accounts: https://otlp.nr-data.net:4318
OTEL_EXPORTER_OTLP_ENDPOINT=https://otlp.eu01.nr-data.net:4318

# Ingest license key, not a User API key. Never commit a real key.
OTEL_EXPORTER_OTLP_HEADERS=api-key=CHANGE_ME_NEW_RELIC_INGEST_LICENSE_KEY

OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
OTEL_EXPORTER_OTLP_COMPRESSION=gzip

OTEL_TRACES_EXPORTER=otlp
OTEL_METRICS_EXPORTER=otlp
OTEL_LOGS_EXPORTER=otlp

# New Relic ingests delta temporality and exponential histograms.
OTEL_EXPORTER_OTLP_METRICS_TEMPORALITY_PREFERENCE=delta
OTEL_EXPORTER_OTLP_METRICS_DEFAULT_HISTOGRAM_AGGREGATION=base2_exponential_bucket_histogram

# New Relic drops attributes longer than 4095 characters.
OTEL_ATTRIBUTE_VALUE_LENGTH_LIMIT=4095
OTEL_EXPERIMENTAL_EXPORTER_OTLP_RETRY_ENABLED=true
OTEL_EXPERIMENTAL_RESOURCE_DISABLED_KEYS=process.command_args
OTEL_SEMCONV_STABILITY_OPT_IN=http

OTEL_RESOURCE_ATTRIBUTES=service.name=microservice-orders,service.version=1.0.0,service.namespace=poc-observability,deployment.environment=local

# Metric export interval in milliseconds
OTEL_METRIC_EXPORT_INTERVAL=30000

# parentbased_always_on keeps the trace started by the gateway or by the caller
OTEL_TRACES_SAMPLER=parentbased_always_on

# Sends the SLF4J key value pairs as structured attributes
OTEL_INSTRUMENTATION_LOGBACK_APPENDER_EXPERIMENTAL_CAPTURE_KEY_VALUE_PAIR_ATTRIBUTES=true
# Sends every MDC entry, which carries the trace and span ids
OTEL_INSTRUMENTATION_LOGBACK_APPENDER_EXPERIMENTAL_CAPTURE_MDC_ATTRIBUTES=*
# Routes the agent own logs through Logback so they also reach New Relic
OTEL_JAVAAGENT_LOGGING=application

# -----------------------------------------------------------------------------
# HTTP headers on the spans
# -----------------------------------------------------------------------------
# Selected headers become span attributes http.request.header.<name> and
# http.response.header.<name>. Bodies are never captured by the agent: that is
# done by the application in OutboundHttpLoggingInterceptor.
# authorization is deliberately absent: the outbound call to the users service
# carries a real credential. traceparent is included on purpose, to make the
# distributed trace between orders and users visible.

OTEL_INSTRUMENTATION_HTTP_SERVER_CAPTURE_REQUEST_HEADERS=content-type,user-agent,x-forwarded-for,traceparent
OTEL_INSTRUMENTATION_HTTP_SERVER_CAPTURE_RESPONSE_HEADERS=content-type,x-trace-id
OTEL_INSTRUMENTATION_HTTP_CLIENT_CAPTURE_REQUEST_HEADERS=content-type,user-agent,traceparent
OTEL_INSTRUMENTATION_HTTP_CLIENT_CAPTURE_RESPONSE_HEADERS=content-type,server

# -----------------------------------------------------------------------------
# Database telemetry over OTLP
# -----------------------------------------------------------------------------

# One span per SQL statement, with the text sanitized (no literal values)
OTEL_INSTRUMENTATION_COMMON_DB_STATEMENT_SANITIZER_ENABLED=true
# Off by default in the agent: adds a span for DataSource.getConnection, which
# is how connection pool waits become visible in a trace
OTEL_INSTRUMENTATION_JDBC_DATASOURCE_ENABLED=true
# Bridges the Micrometer metrics of Actuator (hikaricp.connections.*) to OTLP
OTEL_INSTRUMENTATION_MICROMETER_ENABLED=true

# =============================================================================
# Java agent for local execution
# -----------------------------------------------------------------------------
# The agent jar is downloaded to target/otel-javaagent.jar by "mvn package".
# =============================================================================

# JAVA_TOOL_OPTIONS=-javaagent:./target/otel-javaagent.jar

# =============================================================================
# How to use this file
#   Linux/Mac:  set -a && . ./.env && set +a && mvn spring-boot:run
#   PowerShell: Get-Content .env | Where-Object { $_ -notmatch '^#' -and $_ -match '=' } |
#               ForEach-Object { $k,$v = $_ -split '=',2
#                 [System.Environment]::SetEnvironmentVariable($k, $v) }
#               mvn spring-boot:run
# =============================================================================
